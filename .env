# InsightDI Local Environment & Database Configuration
PROJECT_NAME="InsightDI API"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=insightdi
POSTGRES_PORT=5432
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/insightdi"

# JWT Authentication
SECRET_KEY="insightdi-super-secret-development-key-change-in-production-12345"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Providers
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ACTIVE_LLM_PROVIDER="gemini"

# CORS Origins
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://localhost:8080", "https://*.lovable.app", "https://*.lovableproject.com"]
